#!/bin/sh
# C compiler and linker for Linux targets: zig cc against the glibc named in
# ZIG_TARGET (e.g. aarch64-linux-gnu.2.28), so binaries load on the oldest
# supported glibc whatever the build host runs, and Linux packages can be
# cross-built from macOS. Cargo takes a linker path, not a command line, hence
# this wrapper.
set -e
: "${ZIG_TARGET:?ZIG_TARGET is not set (e.g. aarch64-linux-gnu.2.28)}"
if ! command -v zig >/dev/null 2>&1; then
	echo "zig-cc: zig not found on PATH; Linux packages are built with zig cc" >&2
	exit 127
fi
exec zig cc -target "$ZIG_TARGET" "$@"